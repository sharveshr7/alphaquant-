# AlphaQuant AI Dashboard Configuration
# Paste your Gemini API Key below to enable natural language AI market reasoning:
GEMINI_API_KEY=

# AI Model Selection (gemini-3-flash-preview, gemini-flash-latest, or gemini-3.8-flash)
AI_MODEL=gemini-3-flash-preview

# Optional: Binance API Key & Secret (Public market data and charts work without keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Dry Run Paper Trading Starting Balance
PAPER_BALANCE=1000.0

# Server Host & Port
HOST=127.0.0.1
PORT=8000
