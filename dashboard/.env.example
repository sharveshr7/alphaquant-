# AlphaQuant AI Pro Terminal Configuration
# Optional Gemini API Key for natural language AI reasoning (deterministic engine works without a key):
GEMINI_API_KEY=

# AI Model Selection (gemini-flash-latest, gemini-3.8-flash, gemini-3-flash-preview, gemini-3.5-flash-lite)
AI_MODEL=gemini-flash-latest

# Optional Market-Cap Data Providers (CoinGecko public API works without a key; CoinMarketCap used if set):
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Optional: Binance API Keys (NEVER needed — Public Binance USDⓈ-M Futures API is active without keys; live execution disabled)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Paper Trading Starting Virtual Balance (Analysis & Paper Trading Only)
PAPER_BALANCE=1000.0

# Server Host & Port
HOST=127.0.0.1
PORT=8000
